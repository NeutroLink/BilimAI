.venv*/
__pycache__/
.DS_Store
*.log
models/
out/
# data: raw downloads and derived strips are never committed; small JSON alignments/QA sheets under data/derived/hwr200 are
data/raw/
data/derived/strips_*/
data/derived/hwr200/salvage/*/pages.jsonl
data/derived/hwr200/salvage/*/texts.jsonl
data/derived/hwr200/salvage/*.tgz
data/derived/hwr200/aligned/*/aligned.jsonl
data/derived/hwr200/qa/flagged_*/
eval/testset_v1/ru_pages/images/
eval/testset_v2/ru_pages/images/
eval/runs/_selftest_*
eval/runs/_smoke_*
# 2026-08-22: a single * does not cross directory separators — eval/runs/r6/<arm>/adapter/... is one level
# deeper than the old patterns and 1.1 GB of adapter weights nearly got committed. ** matches at any depth.
eval/runs/**/adapter/tokenizer.json
# 2026-08-24: a trailing suffix defeats `*.safetensors`. An interrupted download renamed to
# adapter_model.safetensors.TRUNCATED-DO-NOT-USE (142 MB, 65 % missing) slipped through this
# rule and had to be stripped from history — it would have made every push to origin fail,
# because GitHub refuses any file over 100 MB. Match ANY suffix.
eval/runs/**/adapter/*.safetensors*
eval/runs/**/adapter/*.bin
eval/runs/**/adapter/training_args.bin
eval/runs/**/pip_list.txt
.ms_upload_cache
eval/testset_v3/ru_pages/images/
# 2026-08-24: the raw candidate-score dumps are 161 MB and 96 MB. GitHub rejects any push
# containing a file over 100 MB, and .git is already 358 MB. They are regenerable compute
# artifacts, not results — the measurements derived from them ARE committed
# (score_ladder.json, gate.json, pooled_v4.json). Keep them on disk; use LFS if they must ship.
eval/runs/dictation/ctc_full_v2.json
eval/runs/dictation/ctc_full_v3.json
eval/runs/dictation/ctc_full_v2_det.json
eval/runs/dictation/ctc_full_v3_det.json

# HiGAN RU bank + Kaggle package: multi-GB h5/code artifacts, rebuilt by tools/higan (stats.json is force-added — configs derive from it)
data/derived/higan_ru_bank/
data/derived/higan_kaggle_pkg/
tools/convtext/out/
tools/convtext/__pycache__/
# HiGAN synthetic ink: ~400k generated crops, rebuilt by tools/higan/synth_higan.py bulk
data/derived/higan_synth_ru*/

# Pilot submissions contain pupil pages and teacher source text; never stage them.
/pilot-data/

# 2026-09-16: the rules above name ctc_full_v2.json and the _det variants, but not the
# per-model/per-colour dumps written beside them — 28 files of ~160 MB each (4.4 GiB) sat
# un-ignored in the working tree, every one above GitHub's 100 MB hard limit, so any
# `git add -A` would have produced a push that GitHub refuses. Match the whole family.
# (*_roc.json stays tracked: those are the small derived metrics, not the dumps.)
eval/runs/dictation/ctc_full_v2_*.json
eval/runs/dictation/ctc_full_v3_*.json

# 2026-09-16: the investor walkthrough is a 107 MB mp4 — over the same hard limit.
# Keep it on disk; ship it as a release asset or via LFS, never as a plain commit.
docs/pitch/motion/*.mp4
.codex-motion/build/

# 2026-09-16: local-only working material — these stay on disk, never on GitHub.
# .lavish/ is the annotation-review tooling output (sheets and row JSON) for adjudicating
# labels by hand; data/derived/my_notebook_v1/boxes/ is word geometry measured on real
# pupil pages, which is pupil data and does not leave this machine.
.lavish/
data/derived/my_notebook_v1/

# 2026-09-16: artifacts and scratch — on disk, never in git.
# Media, logs, temp trees and checksums produced by verification runs. The receipts that
# matter are the small JSON/MD lives beside them, and 584 are already tracked here; ignore
# rules do not untrack them, so reading this tree still works.
.omp/execution/**/*.png
.omp/execution/**/*.jpg
.omp/execution/**/*.jpeg
.omp/execution/**/*.err
.omp/execution/**/*.sha256
.omp/execution/**/tmp/
# Pinned-file manifests and baseline dumps from verification runs: ~20-30 MB each,
# evidence but regenerable and heavy.
.omp/execution/verification/**/manifest_*.json
.omp/execution/verification/**/baseline_*.json
.omp/execution/**/*.pre
.omp/execution/**/*.pre-trace
.omp/execution/**/*.out
# eval/runs keeps its result JSONs tracked (1,269 of them); these are the run's by-products.
eval/runs/**/*.png
eval/runs/**/*.pdf
eval/runs/**/*.jpg
eval/runs/dictation/ctc_PROVCHK_*.json
# Investor-deck build outputs and the motion source, kept local alongside the mp4.
docs/pitch/*.pptx
docs/pitch/motion/*.html
docs/pitch/motion/*.png
.codex-investor-deck/
# Scratch trees written by agents while auditing; nothing here is a deliverable.
geometry_audit/
# Frozen-root trees are absolute local symlinks (bilimai -> this checkout, models -> this
# checkout); committing them would pin another machine's paths.
eval/runs/**/frozen_root/
.hfmigrate/*.out
# codebase-memory's index and client state churn on every query; they are not source.
.codebase-memory/
