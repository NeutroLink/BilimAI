     670.0,
     460.0
    ],
    "text": "вретые нители Венгра."
   },
   {
    "bbox": [
     0.0,
     447.0,
     777.0,
     492.0
    ],
    "text": "Двигаясь по „уши“, советоний"
   },
   {
    "bbox": [
     0.0,
     479.0,
     767.0,
     523.0
    ],
    "text": "секре пору раз постуры по"
   },
   {
    "bbox": [
     0.0,
     509.0,
     747.0,
     553.0
    ],
    "text": "вящник в горах линиотий"
   },
   {
    "bbox": [
     0.0,
     540.0,
     790.0,
     583.0
    ],
    "text": "юри. Роме африкошские гетто"
   },
   {
    "bbox": [
     0.0,
     572.0,
     895.0,
     616.0
    ],
    "text": "назримы суютно, мемен венеровке"
   },
   {
    "bbox": [
     0.0,
     602.0,
     817.0,
     647.0
    ],
    "text": "шанки. Покоре, свеарозими город"
   },
   {
    "bbox": [
     0.0,
     634.0,
     727.0,
     680.0
    ],
    "text": "каваших подоре, а кререди"
   },
   {
    "bbox": [
     0.0,
     666.0,
     747.0,
     710.0
    ],
    "text": "вирпешало шваста. На виоре"
   },
   {
    "bbox": [
     0.0,
     697.0,
     895.0,
     742.0
    ],
    "text": "в неё сидел опроминь одностевеный"
   },
   {
    "bbox": [
     0.0,
     729.0,
     862.0,
     775.0
    ],
    "text": "сновей, которое Ромши увидел"
   },
   {
    "bbox": [
     0.0,
     761.0,
     850.0,
     807.0
    ],
    "text": "по Венере. Слопеу тиссо сонец,"
   },
   {
    "bbox": [
     0.0,
     793.0,
     747.0,
     840.0
    ],
    "text": "уперев говну в виштаву."
   },
   {
    "bbox": [
     0.0,
     825.0,
     897.0,
     871.0
    ],
    "text": "Кокору, сюри дриме не сооронит"
   }
  ],
  "raw": "[{\"bbox_2d\": [0, 143, 756, 189], \"text\": \"вешотные костяные дых перездки-\"}, {\"bbox_2d\": [0, 177, 760, 220], \"text\": \"емые по линетам, это уроторено и\"}, {\"bbox_2d\": [0, 205, 703, 247], \"text\": \"провишков по двину истории.\"}, {\"bbox_2d\": [0, 233, 767, 277], \"text\": \"Перер, дыт дроссими в тониосе\"}, {\"bbox_2d\": [0, 265, 756, 307], \"text\": \"продром срезицентные распрастры,\"}, {\"bbox_2d\": [0, 297, 524, 335], \"text\": \"ударные и конопочтичные.\"}, {\"bbox_2d\": [0, 323, 797, 367], \"text\": \"Тош бойкие Домши находили\"}, {\"bbox_2d\": [0, 355, 756, 398], \"text\": \"дур, тем бойкие он урассилия\"}, {\"bbox_2d\": [0, 385, 839, 431], \"text\": \"средники, в котерове претивам\"}, {\"bbox_2d\": [0, 417, 670, 460], \"text\": \"вретые нители Венгра.\"}, {\"bbox_2d\": [0, 447, 777, 492], \"text\": \"Двигаясь по „уши“, советоний\"}, {\"bbox_2d\": [0, 479, 767, 523], \"text\": \"секре пору раз постуры по\"}, {\"bbox_2d\": [0, 509, 747, 553], \"text\": \"вящник в горах линиотий\"}, {\"bbox_2d\": [0, 540, 790, 583], \"text\": \"юри. Роме африкошские гетто\"}, {\"bbox_2d\": [0, 572, 895, 616], \"text\": \"назримы суютно, мемен венеровке\"}, {\"bbox_2d\": [0, 602, 817, 647], \"text\": \"шанки. Покоре, свеарозими город\"}, {\"bbox_2d\": [0, 634, 727, 680], \"text\": \"каваших подоре, а кререди\"}, {\"bbox_2d\": [0, 666, 747, 710], \"text\": \"вирпешало шваста. На виоре\"}, {\"bbox_2d\": [0, 697, 895, 742], \"text\": \"в неё сидел опроминь одностевеный\"}, {\"bbox_2d\": [0, 729, 862, 775], \"text\": \"сновей, которое Ромши увидел\"}, {\"bbox_2d\": [0, 761, 850, 807], \"text\": \"по Венере. Слопеу тиссо сонец,\"}, {\"bbox_2d\": [0, 793, 747, 840], \"text\": \"уперев говну в виштаву.\"}, {\"bbox_2d\": [0, 825, 897, 871], \"text\": \"Кокору, сюри дриме не сооронит\"}]"
 },
