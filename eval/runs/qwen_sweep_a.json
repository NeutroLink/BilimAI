    "bbox": [
     48.0,
     655.0,
     954.0,
     713.0
    ],
    "text": "римов. Врагом правил в битве"
   },
   {
    "bbox": [
     40.0,
     688.0,
     828.0,
     745.0
    ],
    "text": "советский коммерсант в венере,"
   },
   {
    "bbox": [
     40.0,
     721.0,
     947.0,
     780.0
    ],
    "text": "штабность разными фронтами"
   },
   {
    "bbox": [
     34.0,
     754.0,
     947.0,
     813.0
    ],
    "text": "показуем в Москве, а земли из"
