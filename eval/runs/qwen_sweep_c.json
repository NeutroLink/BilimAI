     639.0
    ],
    "text": "шанки. Покоре, свеарозими город"
   },
   {
    "bbox": [
     0.0,
     627.0,
     727.0,
     671.0
    ],
    "text": "квазиах подоре, а кререди"
   },
   {
    "bbox": [
