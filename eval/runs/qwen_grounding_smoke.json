  "raw": "[{\"bbox_2d\": [0, 143, 758, 206], \"text\": \"вешотьные восточные дых перезви-\"}, {\"bbox_2d\": [0, 179, 723, 238], \"text\": \"емых по линиям, это утверждено и\"}, {\"bbox_2d\": [0, 206, 700, 257], \"text\": \"просвившее по линии истории.\"}, {\"bbox_2d\": [0, 232, 767, 283], \"text\": \"Перер, дых драссимых в тонкое\"}, {\"bbox_2d\": [0, 262, 758, 309], \"text\": \"прореши срецимые рапроторы,\"}, {\"bbox_2d\": [0, 295, 527, 335], \"text\": \"ударные и рошпойтные.\"}, {\"bbox_2d\": [0, 320, 794, 367], \"text\": \"Учи бойкие Ромаш накодился\"}, {\"bbox_2d\": [0, 353, 751, 397], \"text\": \"дур, тем бойкие он умаления\"}, {\"bbox_2d\": [0, 383, 839, 430], \"text\": \"сравниваем, в котором премианы\"}, {\"bbox_2d\": [0, 415, 670, 457], \"text\": \"Кремлевые китены Венера.\"}, {\"bbox_2d\": [0, 445, 770, 490], \"text\": \"Двигается по „уши“, советский\"}, {\"bbox_2d\": [0, 477, 767, 523], \"text\": \"секрет пору раз поступили пос\"}, {\"bbox_2d\": [0, 507, 740, 553], \"text\": \"пячцис в трине ланиотий\"}, {\"bbox_2d\": [0, 537, 790, 583], \"text\": \"пори. Роме африканские гетто\"}, {\"bbox_2d\": [0, 567, 899, 613], \"text\": \"варшись уютное, петели вечерских\"}, {\"bbox_2d\": [0, 597, 817, 645], \"text\": \"сюания. Внёкре, съеворизимы город\"}, {\"bbox_2d\": [0, 627, 727, 677], \"text\": \"вказанных подоре, а кререди\"}, {\"bbox_2d\": [0, 660, 744, 707], \"text\": \"видеиасов шааста. На виоур\"}, {\"bbox_2d\": [0, 693, 897, 743], \"text\": \"в неё сидел окрашив, единственны\"}, {\"bbox_2d\": [0, 725, 860, 780], \"text\": \"человек, которого Ромаш увидел\"}, {\"bbox_2d\": [0, 757, 850, 813], \"text\": \"на Венере. Словоу тиссо сонец,\"}, {\"bbox_2d\": [0, 790, 747, 853], \"text\": \"уредев гоньбу в винтавку.\"}, {\"bbox_2d\": [0, 825, 899, 905], \"text\": \"Консеру, сидри драссе не соороним\"}]"
