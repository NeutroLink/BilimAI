  "raw": "[{\"bbox_2d\": [0, 153, 718, 199], \"text\": \"восми обстоятельств черновики мо-\"}, {\"bbox_2d\": [0, 184, 720, 226], \"text\": \"шими. Она подметена к съворицу, \"}, {\"bbox_2d\": [0, 209, 702, 249], \"text\": \"поганая живёт в то место\"}, {\"bbox_2d\": [0, 237, 548, 274], \"text\": \"где удачливая птица.\"}, {\"bbox_2d\": [638, 247, 670, 263], \"text\": \"и\"}, {\"bbox_2d\": [0, 259, 750, 299], \"text\": \"Коммунистический събориц. Он по-\"}, {\"bbox_2d\": [0, 287, 702, 327], \"text\": \"лез на дерево. Тонка увидела\"}, {\"bbox_2d\": [0, 315, 802, 355], \"text\": \"сама и кинула его между маз.\"}, {\"bbox_2d\": [0, 343, 802, 383], \"text\": \"которы проработали работу. Комм\"}, {\"bbox_2d\": [0, 372, 765, 412], \"text\": \"унов с дерева. Это увидели раб-\"}, {\"bbox_2d\": [0, 399, 792, 440], \"text\": \"ботники, двум рабочим полез\"}, {\"bbox_2d\": [0, 427, 817, 467], \"text\": \"на дерево и овободили птичика.\"}, {\"bbox_2d\": [0, 456, 754, 497], \"text\": \"С того дня съвориц и Тонка\"}, {\"bbox_2d\": [0, 487, 250, 527], \"text\": \"дружат.\"}, {\"bbox_2d\": [708, 475, 784, 515], \"text\": \"474.\"}, {\"bbox_2d\": [0, 515, 607, 555], \"text\": \"Много повторов „он“ нарушена\"}, {\"bbox_2d\": [0, 545, 567, 595], \"text\": \"последовательность текста.\"}, {\"bbox_2d\": [173, 645, 567, 690], \"text\": \"(смнадицатое моя\"}, {\"bbox_2d\": [180, 680, 577, 722], \"text\": \"Класная работа\"}, {\"bbox_2d\": [0, 710, 687, 755], \"text\": \"Коммунистов (что сделали?) вологи.\"}, {\"bbox_2d\": [0, 747, 617, 795], \"text\": \"Смел (что сделал?) работают.\"}, {\"bbox_2d\": [0, 785, 677, 835], \"text\": \"Солныше (что делает?) учит.\"}, {\"bbox_2d\": [0, 825, 792, 875], \"text\": \"Тышицы (что делают?) летают.\"}]"
 },
